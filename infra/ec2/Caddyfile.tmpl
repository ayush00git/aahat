{$SITE_HOST}{$SITE_ALIASES} {
	encode zstd gzip
	handle_path /api/* {
		reverse_proxy 127.0.0.1:8080
	}
	# The dashboard's relative asset URLs need the trailing slash
	redir /officials /officials/
	# Vite's hashed bundles never change; everything else (index.html, the service worker) is revalidated
	@hashed path /assets/* /officials/assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@manifest path *.webmanifest
	header @manifest Content-Type application/manifest+json
	# Both apps use hash routes, so there is no SPA fallback: an unknown path is a 404
	handle_path /officials/* {
		root * /srv/aahat/web/dashboard
		file_server
	}
	handle {
		root * /srv/aahat/web/villager
		file_server
	}
	handle_errors {
		# A mistyped page goes home; a missing file (anything with an extension) stays a 404
		@page expression `{err.status_code} == 404 && !path_regexp('\\.[A-Za-z0-9]+$')`
		redir @page / 302
		respond "{err.status_code} {err.status_text}" {err.status_code}
	}
	log {
		output file /var/log/caddy-access.log
	}
}
